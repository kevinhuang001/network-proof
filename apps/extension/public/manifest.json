{
  "manifest_version": 3,
  "name": "NetProof Companion",
  "version": "0.1.0",
  "description": "只读插件钱包：私钥永远留在离线手机上，签名通过二维码气隙往返。支持 dApp 连接。",
  "minimum_chrome_version": "111",

  "action": {
    "default_title": "NetProof Companion",
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage", "tabs", "unlimitedStorage"],

  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icon.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src https: http://localhost:* http://127.0.0.1:*"
  },

  "icons": {
    "128": "icon.svg"
  }
}
