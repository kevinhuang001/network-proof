{
  "name": "@netproof/hardware",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "NetProof Air — the air-gapped Android hardware wallet (Capacitor + web technologies).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "android:add": "cap add android",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.1",
    "@netproof/core": "workspace:*",
    "@netproof/ui": "workspace:*",
    "@noble/hashes": "2.4.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
