{
  "name": "@netproof/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Air-gapped wallet core: camera-noise entropy, BIP39/BIP32 with passphrase, EVM signing, QR transport protocol.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./entropy": "./src/entropy/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./qr": "./src/qr/index.ts",
    "./vault": "./src/vault/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.6",
    "ed25519-hd-key": "2.0.0",
    "ethers": "6.17.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
